# Entorno local del frontend.
#
#   cp .env.example .env.local
#
# Aquí no hay secretos: la única variable del navegador (`NEXT_PUBLIC_*`) es
# pública por diseño y acaba en el bundle. Los secretos viven en el backend
# (ver docs/entorno.md de ese repo) y en Vercel.

# Proxy de Next hacia el backend (variable de servidor, requerida en local).
# Sin esto, las llamadas a /api/* no se reenvían y la app no llega al backend.
API_PROXY_TARGET=http://127.0.0.1:8000

# Opcional. Vacía = mismo origen: el navegador llama a /api/v1 y Next reenvía.
# Solo se define si el frontend debe llamar directamente a otro origen.
NEXT_PUBLIC_API_BASE_URL=
